# PR6 example environment. Contains NO secrets. Copy to .env only to override defaults.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
MONITOR_PORT=8787
API_PORT=8788

# Web (Vite). Demo mode = local Hardhat test accounts, works ONLY on chainId 31337.
VITE_DEMO_MODE=true
VITE_RPC_URL=http://127.0.0.1:8545
VITE_CHAIN_ID=31337

# Fault injection flags - ONLY for acceptance tests. Keep disabled.
FAULT_TAMPER_AMOUNT=0
FAULT_CRASH_AFTER=

# All local accounts are derived at runtime from the PUBLIC Hardhat test mnemonic
# "test test test test test test test test test test test junk".
# These keys are world-known and MUST NEVER be used on a real network.
